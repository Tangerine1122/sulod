# Copy to .env.local and fill in from Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: the public URL used in magic-link emails (defaults to the request origin)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI quick-add goes through Vercel AI Gateway.
# On Vercel deployments this is not needed (the project authenticates automatically).
# Locally, and for `npm run eval:quick-add`, create a key at vercel.com → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=
# Optional: switch the model (default anthropic/claude-haiku-5.5)
# QUICK_ADD_MODEL=google/gemini-3.5-flash-lite
